rules_version = '2';

// INTERIM RULES (roadmap P5.1b). They match what the browser does today: quiz taking still reads the
// questions and writes `responses` from the client. P5.2 moves that to server routes (Admin SDK), and
// P5.5 replaces this file with the final lockdown (no client reads of answers, no client writes to scores).
// Known gaps until then: questions are readable by anyone (answers included), and a player can still
// create a response for themselves with a score of their choosing.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    // Guests are not Firebase-authenticated; their responses carry the userId "anonymous".
    function submitterId() {
      return isAuthenticated() ? request.auth.uid : "anonymous";
    }

    function ownsResponse(responseId) {
      return exists(/databases/$(database)/documents/responses/$(responseId)) &&
        get(/databases/$(database)/documents/responses/$(responseId)).data.userId == submitterId();
    }

    function validScore(score) {
      return score == null || (score is number && score >= 0 && score <= 100);
    }

    match /users/{userId} {
      // Signed-in only (the leaderboard shows other players' names). Was public.
      allow read: if isAuthenticated();

      // Self-registration can't pick its own role.
      allow create: if isOwner(userId) &&
        request.resource.data.get("role", "user") == "user" &&
        (!("customClaims" in request.resource.data) ||
         request.resource.data.customClaims.get("role", "user") == "user");

      allow update: if isAdmin() ||
        (isOwner(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "customClaims"]));

      allow delete: if isAdmin();
    }

    // Quizzes and everything under them (questions, questions_easy|medium|hard, ...).
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{subCollection}/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // One response per attempt (the attempt id is the document id).
    match /responses/{responseId} {
      allow read: if isAuthenticated();

      allow create: if request.resource.data.userId == submitterId() &&
        validScore(request.resource.data.score);

      // A retry rewrites the same document; the owner can't change what it says about the result.
      allow update: if isAdmin() ||
        (isOwner(resource.data.userId) &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.quizId == resource.data.quizId &&
         request.resource.data.score == resource.data.score);

      allow delete: if isAdmin();

      match /answers/{answerId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() || ownsResponse(responseId);
        allow delete: if isAdmin();
      }
    }

    match /userActivities/{activityId} {
      allow read: if isAuthenticated() &&
                    (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
