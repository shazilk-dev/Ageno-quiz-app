rules_version = '2';

// FINAL RULES (performance plan S4.3; before that roadmap P5.5). The browser never uses Firestore: players,
// admins and a person's own profile and activity log all go through the server routes under app/api
// (Admin SDK, which bypasses these rules). The client bundle doesn't even include the Firestore SDK. So
// every read and write from a browser is denied, whoever is signed in, admins included.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
